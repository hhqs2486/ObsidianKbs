# 复制为 .env 后填写（不要提交 .env）

# --- 通用 LLM（Step 1 / mem0 / agent 回答生成）---
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- RAGFlow（Step 2–4，RAG 检索与带引用回答）---
# 本地 Docker 部署后默认 http://127.0.0.1:9380
# RAGFLOW_BASE_URL=http://127.0.0.1:9380
# RAGFLOW_API_KEY=ragflow-...
# RAGFLOW_DATASET_NAME=stage2_kb

# --- mem0（Step 5，长期用户记忆）---
# 默认使用 OPENAI_API_KEY；数据落在 ~/.mem0 与 /tmp/qdrant
MEM0_USER_ID=stage2_demo_user

# --- Letta（Step 6，上下文压缩 / compaction）---
# 云端：https://app.letta.com/ 获取 API Key
# 自托管：设置 LETTA_BASE_URL=http://127.0.0.1:8283
# LETTA_API_KEY=letta-...
# LETTA_MODEL=openai/gpt-4o-mini
