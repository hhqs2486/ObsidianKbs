# 复制为 .env 后填写（不要提交 .env 到 git）

# --- API（OpenAI 兼容）---
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Agent 运行约束 ---
AGENT_MAX_STEPS=12
AGENT_REQUEST_TIMEOUT_SEC=60
AGENT_MAX_RETRIES=2

# --- 成本上限（美元，估算值；common.py 按 token 粗算）---
AGENT_MAX_COST_USD=0.50

# --- 可观测性 ---
AGENT_TRACE_DIR=traces
AGENT_LOG_LEVEL=INFO

# --- Smoke / 本地测试（Step 9 使用，不调用真实 API）---
AGENT_DRY_RUN=false
